[Unit]
Description=VIM4 JetKVM web application
Requires=vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
After=network-online.target vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
Wants=network-online.target
# Both applications use HDMI capture, the encoder, HID endpoints and port 8080.
Conflicts=nanokvm.service

[Service]
Type=simple
User=khadas
Group=khadas
SupplementaryGroups=video input
StateDirectory=jetkvm
StateDirectoryMode=0700
WorkingDirectory=/var/lib/jetkvm
Environment=GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
ExecStart=/opt/vim4-jetkvm/jetkvm
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# amlvenc uses a shared lock file in /tmp. All encoder users must use khadas.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
