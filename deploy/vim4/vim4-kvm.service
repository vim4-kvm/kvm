[Unit]
Description=VIM4 JetKVM web application
Requires=vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
After=network-online.target vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
Wants=network-online.target
# Applications share HDMI capture, the encoder, HID endpoints and backend port 8081.
Conflicts=nanokvm.service

[Service]
Type=simple
User=khadas
Group=khadas
# HDMI audio capture and the application journal for diagnostics.
SupplementaryGroups=video input audio systemd-journal
# Privileged changes use sudo and /usr/libexec/vim4-jetkvm, so
# NoNewPrivileges must stay unset.
StateDirectory=jetkvm
StateDirectoryMode=0700
WorkingDirectory=/var/lib/jetkvm
Environment=GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
ExecStart=/opt/vim4-jetkvm/jetkvm
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# amlvenc uses a shared lock file in /tmp. All encoder users must use khadas.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
